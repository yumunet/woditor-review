{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woditor-review/response/v1",
  "title": "Woditor Review response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "responses", "suggestions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 1},
    "responses": {"type": "array", "items": {"$ref": "#/$defs/response"}},
    "suggestions": {"type": "array", "items": {"$ref": "#/$defs/suggestion"}}
  },
  "$defs": {
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["slotId", "before", "after"],
      "properties": {"slotId": {"type": "string"}, "before": {"type": "string"}, "after": {"type": "string"}}
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["commentId", "path", "itemId", "fileVersion", "decision", "reason", "changes"],
      "properties": {
        "commentId": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "itemId": {"type": "string", "minLength": 1},
        "fileVersion": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "decision": {"enum": ["accepted", "rejected", "partial", "needs_review"]},
        "reason": {"type": "string", "minLength": 1},
        "explanation": {"type": "string"},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
      }
    },
    "suggestion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "itemId", "fileVersion", "reason", "changes"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "itemId": {"type": "string", "minLength": 1},
        "fileVersion": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reason": {"type": "string", "minLength": 1},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
      }
    }
  }
}
